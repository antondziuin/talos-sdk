<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: not every member is doc'd yet (MVP). CA1416: Registry access is
         runtime-guarded to Windows. -->
    <NoWarn>$(NoWarn);1591;CA1416</NoWarn>
    <PackageId>Talos.Sdk</PackageId>
    <Version>0.0.0</Version>
    <Description>Client SDK for the Talos licensing &amp; software-protection platform.</Description>
    <Authors>Talos</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The symbols nobody thinks about until they are looking at a stack trace
         from a customer's machine. A `.snupkg` beside the package lets a
         debugger step into this library from an application that only ever
         referenced it, which is the difference between "somewhere inside the
         licensing SDK" and a line number. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- SourceLink, which ships inside the .NET SDK: these two properties are
         all it needs to stamp the package with where the source came from and
         to embed the files git does not track (the generated serializers).
         There is no remote on this repository yet, so today they resolve to
         nothing; the day there is one, the packages already carry it rather
         than the first release after somebody remembers. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- A deterministic build: the same source produces byte-identical output, so
       a package can be rebuilt from a tag and compared with the one that was
       published. Only under CI, because the path mapping it turns on makes
       local debugging worse for no gain on a machine that is not publishing. -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == '' and '$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Turns on the trim/AOT/single-file analyzers, which are what actually keep
       this library reflection-free: every JSON call goes through a generated
       serializer (WireJson, StateJson), and a reflective one coming back is a
       build error rather than an app that ships and sends `{}`. net8.0 only —
       the analyzers do not exist for netstandard2.0, and neither does an AOT
       publish to protect. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
