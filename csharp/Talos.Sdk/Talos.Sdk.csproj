<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: not every member is doc'd yet (MVP). CA1416: Registry access is
         runtime-guarded to Windows. -->
    <NoWarn>$(NoWarn);1591;CA1416</NoWarn>
    <PackageId>Talos.Sdk</PackageId>
    <Version>0.0.0</Version>
    <Description>Client SDK for the Talos licensing &amp; software-protection platform.</Description>
    <Authors>Talos</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
